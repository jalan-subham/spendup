# Supabase (shared DB for local + production)
# Runtime (pooled via Supavisor / pgbouncer)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations (direct connection)
# Use the exact direct URL from Supabase dashboard Database > Connection string.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@db.<project-ref>.supabase.co:5432/postgres"

# App secrets
JWT_SECRET="change-this-to-a-long-random-secret"
GROQ_API_KEY="your-groq-api-key"
